---
import Button from '@/components/ui/Button.astro';
import { getAbout } from '@/data/content';

const about = getAbout();
---

<section id="a-propos" class="py-16 sm:py-24 bg-secondary-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="relative">
        <div class="aspect-[4/5] rounded-xl overflow-hidden shadow-lg">
          <img src="/images/about-portrait.jpg" alt="Sandra et Gaylord, fondateurs de Plume de Lapin" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="absolute -bottom-6 -right-4 sm:right-8 w-32 h-32 rounded-xl border-4 border-secondary-50 shadow-lg overflow-hidden">
          <img src="/images/about-vie-ferme.jpg" alt="La vie à la ferme" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

      <!-- Texte -->
      <article class="lg:py-6">
        <span class="inline-block bg-primary-100 text-primary-800 text-xs font-semibold px-4 py-1.5 rounded-full border border-primary-200 mb-5">
          Notre histoire
        </span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-primary-900" data-cms-field="about.directorName" data-cms-type="text">
          {about.directorName}
        </h2>
        <p class="text-primary-600 font-medium mt-2 italic mb-6" data-cms-field="about.tagline" data-cms-type="text">{about.tagline}</p>

        <div class="text-neutral-700 space-y-4 leading-relaxed">
          <p data-cms-field="about.paragraph1" data-cms-type="text">{about.paragraph1}</p>
          <p data-cms-field="about.paragraph2" data-cms-type="text">{about.paragraph2}</p>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <Button href="/a-propos" variant="primary">
            Lire la suite
          </Button>
          <Button href="/contact" variant="ghost">
            Nous rendre visite
          </Button>
        </div>
      </article>
    </div>
  </div>
</section>
