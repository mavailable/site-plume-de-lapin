---
const photos = [
  { caption: 'La ferme', aspect: 'col-span-2 row-span-2', src: '/images/galerie-ferme.jpg' },
  { caption: 'Les poules', aspect: '', src: '/images/galerie-poules.jpg' },
  { caption: 'Les œufs', aspect: '', src: '/images/galerie-oeufs.jpg' },
  { caption: 'Les lapins', aspect: '', src: '/images/galerie-lapins.jpg' },
  { caption: 'Le poulailler', aspect: '', src: '/images/galerie-poulailler.jpg' },
  { caption: 'Sandra & Gaylord', aspect: 'col-span-2', src: '/images/galerie-portrait.jpg' },
];
---

<section id="galerie" class="py-16 sm:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block bg-accent-100 text-accent-800 text-xs font-semibold px-4 py-1.5 rounded-full border border-accent-200 mb-4">
        La ferme en images
      </span>
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-primary-900">
        Bienvenue chez nous
      </h2>
      <p class="mt-3 text-neutral-600">Découvrez notre ferme familiale à Lantefontaine</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      {photos.map((photo) => (
        <div class={`${photo.aspect} rounded-xl overflow-hidden min-h-[140px] group`}>
          <img src={photo.src} alt={photo.caption} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>
