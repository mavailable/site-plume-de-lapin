---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import { getAbout } from '@/data/content';

const about = getAbout();
---

<BaseLayout
  title="Notre histoire — Plume de Lapin, ferme familiale en Lorraine"
  description="Découvrez Sandra et Gaylord, fondateurs de Plume de Lapin. Ferme avicole familiale, circuit court et respect du bien-être animal à Lantefontaine (54)."
>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        <div class="lg:col-span-2">
          <div class="aspect-[4/5] rounded-2xl overflow-hidden sticky top-24">
            <img src="/images/about-page.jpg" alt="Sandra et Gaylord, fondateurs de Plume de Lapin" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>

        <!-- Texte -->
        <article class="lg:col-span-3">
          <h1 class="text-3xl sm:text-4xl font-heading font-bold text-primary-900 mb-2">
            Notre histoire
          </h1>
          <p class="text-primary-600 font-medium text-lg mb-8" data-cms-field="about.tagline" data-cms-type="text">{about.tagline}</p>

          <div class="text-neutral-700 space-y-5 leading-relaxed">
            <p data-cms-field="about.paragraph1" data-cms-type="text">{about.paragraph1}</p>
            <p data-cms-field="about.paragraph2" data-cms-type="text">{about.paragraph2}</p>
            <p data-cms-field="about.paragraph3" data-cms-type="text">{about.paragraph3}</p>
            <p data-cms-field="about.paragraph4" data-cms-type="text">{about.paragraph4}</p>
            <p data-cms-field="about.paragraph5" data-cms-type="text">{about.paragraph5}</p>
            <p data-cms-field="about.paragraph6" data-cms-type="text">{about.paragraph6}</p>
          </div>

          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <Button href="/boutique" variant="primary" size="lg">
              Découvrir nos produits
            </Button>
            <Button href="/contact" variant="outline">
              Nous contacter
            </Button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
